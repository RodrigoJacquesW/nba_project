config {
  type: "table",
  schema: "modeling",
  description: "Fact: player box score. Grain = player x game.",
  assertions: {
    uniqueKey: ["id_player", "id_game"],
    nonNull: ["id_player", "id_game", "id_team", "game_date"],
    rowConditions: ["points >= 0", "player_minutes >= 0"]
  }
}

select
    id_season,
    id_player,
    id_team,
    id_game,
    game_date,
    matchup,
    win_or_loss,
    minutes                     as player_minutes,
    field_goals_made,
    field_goals_tried,
    field_goal_percentage,
    three_point_made,
    three_point_tried,
    three_point_percentage,
    free_throws_made,
    free_throws_tried,
    free_throws_percentage,
    offensive_rebounds,
    defensive_rebounds,
    total_rebounds,
    assist,
    steals,
    blocks,
    turnovers,
    personal_fouls,
    points,
    plus_minus
from ${ref("stg_player_gamelog")}

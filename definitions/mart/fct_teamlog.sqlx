config {
  type: "table",  
  schema: "modeling",
  name: "fct_teamlog"
}

WITH join_date AS (

  SELECT
      tl.SEASON_ID AS id_season,
      tl.TEAM_ID AS id_team,
      tl.TEAM_ABBREVIATION AS team_abbreviation,
      tl.TEAM_NAME AS team_name,
      tl.GAME_ID AS id_game,
      tl.MATCHUP AS matchup,
      tl.WL AS win_or_loss,
      tl.MIN AS team_minutes,
      tl.FGM AS field_goals_made,
      tl.FGA AS field_goals_tried,
      tl.FG_PCT  AS field_goal_percentage,
      tl.FG3M AS three_point_made,
      tl.FG3A AS three_point_tried,
      tl.FG3_PCT AS three_point_percentage,
      tl.FTM AS free_throws_made,
      tl.FTA AS free_throws_tried,
      tl.FT_PCT AS free_throws_poercentage,
      tl.OREB AS offensive_rebounds,
      tl.DREB AS defensive_rebounds,
      tl.REB AS total_rebounds,
      tl.AST AS assist,
      tl.STL AS steals,
      tl.BLK AS blocks,
      tl.TOV AS turnovers,
      tl.PF AS personal_fouls,
      tl.PTS AS points,
      tl.PLUS_MINUS AS plus_minus,
      DATE(gu.game_date) AS game_date
  FROM
    ${ref("stg_teamlog")} AS tl
  LEFT JOIN  
    ${ref("stg_games_unique")} AS gu
  ON tl.GAME_ID = gu.GAME_ID
  
)

SELECT
  *
FROM
  join_date